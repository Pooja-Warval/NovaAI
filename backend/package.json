  "description": "Nova AI - Production-Ready AI Avatar Backend Module using D-ID Agents API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:ts-node": "ts-node-dev --respawn --transpile-only src/server.ts",
