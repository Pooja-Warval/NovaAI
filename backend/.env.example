# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend Origin for CORS and D-ID Client Key domain restriction
FRONTEND_URL=http://localhost:5173

# D-ID API Credentials
# Get your API key from D-ID Studio: https://studio.d-id.com/account-settings
# Format: either "username:password" or base64 encoded string
DID_API_KEY=

# Pre-existing or Initialized D-ID Agent ID
# Leave empty to automatically create via POST /api/avatar/initialize, or provide an existing agent id (e.g. agt_...)
DID_AGENT_ID=

# Pre-existing D-ID Client Key (Optional: can be dynamically generated via POST /api/avatar/client-key)
DID_CLIENT_KEY=

# D-ID Presenter Configuration
# Default: Clip type presenter (e.g. v2_public_Amber@0zSz8kflCN)
DID_PRESENTER_ID=v2_public_Amber@0zSz8kflCN

# D-ID Voice Configuration
# High quality Multilingual voice supporting English, Hindi, and regional pronunciations
# Examples: en-US-JennyMultilingualV2Neural, en-IN-NeerjaMultilingualNeural
DID_VOICE_ID=en-US-JennyMultilingualV2Neural
